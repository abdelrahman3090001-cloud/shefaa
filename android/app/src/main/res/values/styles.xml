<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme applied to the Android Window while the Flutter process is starting -->
    <style name="LaunchTheme" parent="android:Theme.Light.NoTitleBar">
        <!-- Show a white background instead of a splash screen -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview" tools:ignore="NewApi">true</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the Flutter process is running -->
    <style name="NormalTheme" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
